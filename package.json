{
  "name": "fluentui-vue",
  "version": "0.0.1",
  "description": "Fluent Design 2 设计规范的 Vue3 实现",
  "homepage": "https://fluentui-vue.nahida.website",
  "repository": {
    "type": "git",
    "url": "https://github.com/Altermoe/fluentui-vue"
  },
  "scripts": {
    "dev": "pnpm --filter @fluentui-vue/docs dev",
    "docs:dev": "pnpm --filter @fluentui-vue/docs dev",
    "docs:build": "pnpm --filter @fluentui-vue/docs build",
    "docs:generate": "pnpm --filter @fluentui-vue/docs generate",
    "docs:preview": "pnpm --filter @fluentui-vue/docs preview",
    "build": "pnpm -r build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "tsc": "pnpm -r tsc",
    "check": "pnpm lint && pnpm format && pnpm tsc"
  },
  "keywords": [
    "fluentui",
    "component library",
    "ui framework",
    "ui",
    "vue",
    "vue3"
  ],
  "author": "夕云葛城",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "^6.0.3",
    "vite": "8.1.5"
  }
}
