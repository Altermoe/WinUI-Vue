{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitThis": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/tmp/tsconfig.tsbuildinfo",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "@fluentui-vue/themes": ["./packages/themes/src/index.ts"],
      "@fluentui-vue/themes/*": ["./packages/themes/src/*"],
      "@fluentui-vue/designs": ["./packages/designs/src/index.ts"],
      "@fluentui-vue/designs/*": ["./packages/designs/src/*"],
      "@fluentui-vue/ui": ["./packages/ui/src/index.ts"],
      "@fluentui-vue/ui/*": ["./packages/ui/src/*"],
      "@fluentui-vue/hooks": ["./packages/hooks/src/index.ts"],
      "@fluentui-vue/hooks/*": ["./packages/hooks/src/*"],
      "@fluentui-vue/utils": ["./packages/utils/src/index.ts"],
      "@fluentui-vue/utils/*": ["./packages/utils/src/*"]
    }
  }
}
